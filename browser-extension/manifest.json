{
  "manifest_version": 3,
  "name": "В желания",
  "description": "Добавляет открытую карточку товара в «Список желаний» — без AI, когда цена уже видна.",
  "version": "1.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-192.png",
    "32": "icon-192.png",
    "48": "icon-192.png",
    "128": "icon-192.png"
  },
  "action": {
    "default_title": "Добавить товар в «Список желаний»",
    "default_icon": "icon-192.png"
  },
  "options_page": "options.html"
}
